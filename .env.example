# NAADYANTRA Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Application
APP_NAME=NAADYANTRA
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./naadyantra.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/naadyantra

# Security
# Generate a strong random secret key for production
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Device Authentication
# Generate bcrypt hash with: python -c "from passlib.context import CryptContext; import bcrypt; print(bcrypt.hashpw(b'your-device-key', bcrypt.gensalt()).decode())"
DEVICE_KEY_HASH=$2b$12$your-bcrypt-hash-here

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (adjust for production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Device Status Threshold (seconds)
DEVICE_OFFLINE_THRESHOLD=300

# Firmware Sensor Defaults
GAS_SENSOR_ENABLED=True
MOISTURE_SENSOR_ENABLED=True
HEAT_SENSOR_ENABLED=False
UV_SENSOR_ENABLED=False

# NAADYANTRA Backend Configuration
# ─────────────────────────────────────────────────────────────
# LOCAL DEV  → copy this file to .env and fill in values
# RENDER     → paste each variable in Dashboard > Environment
# DO NOT commit .env to version control
# ─────────────────────────────────────────────────────────────


# ── DATABASE ─────────────────────────────────────────────────
# Local SQLite (dev only):
DATABASE_URL=sqlite:///./hazguard.db
# Render PostgreSQL (copy "Internal Database URL" from Render dashboard):
# DATABASE_URL=postgresql://user:password@host/dbname


# ── SERVER ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Set to "production" on Render
ENVIRONMENT=development


# ── SECURITY ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── DEVICE AUTH ──────────────────────────────────────────────
# bcrypt hash of your ESP32 device key
# Generate with:
#   python -c "from passlib.context import CryptContext; ctx = CryptContext(schemes=['bcrypt']); print(ctx.hash('your-device-key'))"
DEVICE_KEY_HASH=REPLACE_WITH_BCRYPT_HASH


# ── THRESHOLDS ───────────────────────────────────────────────
DEVICE_ONLINE_THRESHOLD_SECONDS=300

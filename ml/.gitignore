# ML Artifacts and Large Files
*.pkl
*.joblib
*.h5
*.pb
*.tflite
*.onnx
*.safetensors
*.ckpt
*.pth

# Raw Data (too large for Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
# Keep manifests for provenance tracking
!data/manifests/
!data/manifests/**

# Model Artifacts
models/*
!models/.gitkeep

# Reports (may contain large figures)
reports/*
!reports/.gitkeep

